# PostgreSQL-anslutning från Neon (server-only, får aldrig prefixas med NEXT_PUBLIC_)
DATABASE_URL=

# Neon CLI may also populate these. The app currently uses DATABASE_URL only.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Minst 32 slumpmässiga tecken. Skapa med: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Applikationens absoluta URL; lokalt http://localhost:3000, i drift er HTTPS-domän
BETTER_AUTH_URL=http://localhost:3000
